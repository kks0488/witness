# No credentials are needed for the demo. Keep real values in .env.local only.
VITE_MODEL_MODE=demo
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_APP_CHECK_SITE_KEY=
# Pre-register privately in Firebase. This app exchanges it without SDK debug logging.
VITE_APP_CHECK_DEBUG_TOKEN=
# Explicit operator confirmation of an existing Spark project WITHOUT linked billing.
VITE_SPARK_FREE_TIER_CONFIRMED=false
# Optional hypothesis witness: local fact extraction + local code verdict (legacy paths stay available)
# VITE_WITNESS_MODE=extract-code
